#include <windows.h>
#include "panel_res.h"
#ifndef AES67VSC_VERSION
#define AES67VSC_VERSION "0.6.0"
#endif

1 RT_MANIFEST "panel.manifest"
IDI_APP         ICON "../../res/app.ico"
IDI_TRAY_GREY   ICON "../../res/tray_grey.ico"
IDI_TRAY_GREEN  ICON "../../res/tray_green.ico"
IDI_TRAY_YELLOW ICON "../../res/tray_yellow.ico"
IDI_TRAY_RED    ICON "../../res/tray_red.ico"

// Main window: 100 dlu sidebar on the left, content pages on the right, footer at the bottom.
IDD_MAIN DIALOGEX 0, 0, 560, 380
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_ACCEPTFILES
CAPTION "AES67 Virtual Sound Card"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "AES67 VSC", IDC_APPTITLE, 12, 12, 80, 14, SS_LEFT | SS_NOPREFIX
    LTEXT           "virtual sound card", IDC_APPSUB, 12, 27, 84, 10, SS_LEFT | SS_NOPREFIX
    CONTROL         "Status", IDC_NAV0, "Button", BS_OWNERDRAW | WS_TABSTOP, 6, 48, 88, 20
    CONTROL         "Streams", IDC_NAV1, "Button", BS_OWNERDRAW | WS_TABSTOP, 6, 70, 88, 20
    CONTROL         "Bridge", IDC_NAV2, "Button", BS_OWNERDRAW | WS_TABSTOP, 6, 92, 88, 20
    CONTROL         "Settings", IDC_NAV3, "Button", BS_OWNERDRAW | WS_TABSTOP, 6, 114, 88, 20
    LTEXT           "", IDC_VERSION, 12, 362, 84, 10, SS_LEFT | SS_NOPREFIX
    LTEXT           "", IDC_FOOT, 110, 362, 270, 10, SS_LEFT | SS_NOPREFIX
    CONTROL         "Apply", IDC_APPLY, "Button", BS_OWNERDRAW | WS_TABSTOP, 392, 356, 56, 18
    CONTROL         "Hide", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 452, 356, 48, 18
    CONTROL         "Exit", IDC_EXIT, "Button", BS_OWNERDRAW | WS_TABSTOP, 504, 356, 48, 18
END

IDD_PAGE_STATUS DIALOGEX 0, 0, 448, 340
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_DOT_MAIN, "Static", SS_OWNERDRAW, 12, 12, 14, 14
    LTEXT           "", IDC_HEAD, 32, 9, 410, 16, SS_LEFT | SS_NOPREFIX
    LTEXT           "", IDC_SUB, 32, 27, 410, 10, SS_LEFT | SS_NOPREFIX
    CONTROL         "", IDC_LINE_BASE+0, "Static", SS_OWNERDRAW, 12, 44, 424, 1

    CONTROL         "", IDC_DOT_DRV, "Static", SS_OWNERDRAW, 14, 56, 8, 8
    LTEXT           "ASIO driver", -1, 28, 55, 62, 10
    LTEXT           "", IDC_VAL_DRV, 94, 55, 348, 20, SS_LEFT | SS_NOPREFIX
    CONTROL         "", IDC_DOT_BR, "Static", SS_OWNERDRAW, 14, 84, 8, 8
    LTEXT           "Audio bridge", -1, 28, 83, 62, 10
    LTEXT           "", IDC_VAL_BR, 94, 83, 348, 20, SS_LEFT | SS_NOPREFIX
    CONTROL         "", IDC_DOT_CLK, "Static", SS_OWNERDRAW, 14, 112, 8, 8
    LTEXT           "Clock (PTP)", -1, 28, 111, 62, 10
    LTEXT           "", IDC_VAL_CLK, 94, 111, 348, 20, SS_LEFT | SS_NOPREFIX
    CONTROL         "", IDC_DOT_RX, "Static", SS_OWNERDRAW, 14, 140, 8, 8
    LTEXT           "Incoming", -1, 28, 139, 62, 10
    LTEXT           "", IDC_VAL_RX, 94, 139, 348, 20, SS_LEFT | SS_NOPREFIX
    CONTROL         "", IDC_DOT_TX, "Static", SS_OWNERDRAW, 14, 168, 8, 8
    LTEXT           "Outgoing", -1, 28, 167, 62, 10
    LTEXT           "", IDC_VAL_TX, 94, 167, 348, 20, SS_LEFT | SS_NOPREFIX

    CONTROL         "", IDC_LINE_BASE+1, "Static", SS_OWNERDRAW, 12, 196, 424, 1
    CONTROL         "Start bridge", IDC_ST_BRIDGE, "Button", BS_OWNERDRAW | WS_TABSTOP, 28, 206, 90, 18
    CONTROL         "Teams preset...", IDC_ST_TEAMS, "Button", BS_OWNERDRAW | WS_TABSTOP, 124, 206, 90, 18
    LTEXT           "", IDC_COUNTERS, 28, 234, 410, 30, SS_LEFT | SS_NOPREFIX
    LTEXT           "Closing or minimising this window keeps everything running in the notification area. The tray icon shows the same colour as the indicator above.", IDC_ST_HINT, 28, 306, 410, 20, SS_LEFT | SS_NOPREFIX
END

IDD_PAGE_STREAMS DIALOGEX 0, 0, 448, 340
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Incoming stream", IDC_SEC_BASE+0, 12, 10, 200, 12
    LTEXT           "received from the network  ->  driver inputs / virtual microphone", -1, 12, 23, 300, 10
    CONTROL         "Load SDP file...", IDC_RX_LOAD, "Button", BS_OWNERDRAW | WS_TABSTOP, 336, 10, 100, 18
    CONTROL         "Receive enabled", IDC_RX_ENABLE, "Button", BS_OWNERDRAW | WS_TABSTOP, 12, 40, 90, 10
    LTEXT           "", IDC_RX_INFO, 12, 56, 424, 36, SS_LEFT | SS_NOPREFIX
    LTEXT           "Discovered on the network (SAP):", -1, 12, 97, 120, 10
    COMBOBOX        IDC_RX_DISCOVERED, 12, 109, 262, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Use", IDC_RX_USE, "Button", BS_OWNERDRAW | WS_TABSTOP, 280, 108, 44, 16
    CONTROL         "Clear stream", IDC_RX_CLEAR, "Button", BS_OWNERDRAW | WS_TABSTOP, 336, 108, 100, 16
    LTEXT           "Stream channel for input 1:", -1, 12, 130, 100, 10
    EDITTEXT        IDC_RX_CHOFF, 114, 128, 28, 12, ES_NUMBER
    LTEXT           "(multichannel streams; input 2 takes the next channel)", -1, 148, 130, 230, 10

    CONTROL         "", IDC_LINE_BASE+2, "Static", SS_OWNERDRAW, 12, 150, 424, 1

    LTEXT           "Outgoing stream", IDC_SEC_BASE+1, 12, 160, 200, 12
    LTEXT           "driver outputs / virtual speaker  ->  transmitted to the network", -1, 12, 173, 300, 10
    CONTROL         "Transmit enabled", IDC_TX_ENABLE, "Button", BS_OWNERDRAW | WS_TABSTOP, 12, 190, 90, 10
    CONTROL         "Announce via SAP so devices can discover it", IDC_TX_SAP, "Button", BS_OWNERDRAW | WS_TABSTOP, 120, 190, 200, 10
    LTEXT           "Stream name:", -1, 12, 210, 60, 10
    EDITTEXT        IDC_TX_NAME, 76, 208, 200, 12
    LTEXT           "Multicast address:", -1, 12, 228, 60, 10
    EDITTEXT        IDC_TX_DEST, 76, 226, 90, 12
    LTEXT           "Port:", -1, 176, 228, 20, 10
    EDITTEXT        IDC_TX_PORT, 198, 226, 40, 12, ES_NUMBER
    LTEXT           "Encoding:", -1, 12, 246, 60, 10
    COMBOBOX        IDC_TX_ENC, 76, 244, 60, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "1 ms packets, PTP media clock. Channel count follows Settings.", -1, 146, 246, 290, 10
    CONTROL         "Save SDP file...", IDC_TX_EXPORT, "Button", BS_OWNERDRAW | WS_TABSTOP, 12, 268, 100, 18
    CONTROL         "Copy SDP to clipboard", IDC_TX_COPY, "Button", BS_OWNERDRAW | WS_TABSTOP, 118, 268, 110, 18
    LTEXT           "Give the SDP to the receiver (Dante Controller, Ravenna, another PC with this driver).", -1, 236, 272, 200, 20

    LTEXT           "Tip: drop an .sdp file anywhere on this window to load it as the incoming stream.", -1, 12, 318, 424, 10
END

IDD_PAGE_BRIDGE DIALOGEX 0, 0, 448, 340
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Windows audio bridge", IDC_SEC_BASE+2, 12, 10, 300, 12
    LTEXT           "", IDC_BR_INTRO, 12, 24, 424, 30, SS_LEFT | SS_NOPREFIX
    CONTROL         "", IDC_LINE_BASE+3, "Static", SS_OWNERDRAW, 12, 60, 424, 1

    LTEXT           "Routing", IDC_SEC_BASE+3, 12, 70, 200, 12
    LTEXT           "Incoming stream (from network) plays on:", -1, 12, 88, 150, 10
    COMBOBOX        IDC_BR_PLAY, 164, 86, 272, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Outgoing stream (to network) is taken from:", -1, 12, 108, 150, 10
    COMBOBOX        IDC_BR_SOURCE, 164, 106, 272, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_BR_HINT, 12, 126, 424, 20, SS_LEFT | SS_NOPREFIX

    CONTROL         "Start bridge", IDC_BR_START, "Button", BS_OWNERDRAW | WS_TABSTOP, 12, 152, 90, 18
    CONTROL         "Teams preset...", IDC_BR_TEAMS, "Button", BS_OWNERDRAW | WS_TABSTOP, 108, 152, 90, 18
    CONTROL         "Get VB-CABLE...", IDC_BR_GETCABLE, "Button", BS_OWNERDRAW | WS_TABSTOP, 204, 152, 90, 18
    LTEXT           "", IDC_BR_STATUS, 300, 156, 136, 12, SS_LEFT | SS_NOPREFIX
    CONTROL         "Start the bridge automatically when this app starts", IDC_BR_AUTO, "Button", BS_OWNERDRAW | WS_TABSTOP, 12, 178, 300, 10

    CONTROL         "", IDC_LINE_BASE+4, "Static", SS_OWNERDRAW, 12, 196, 424, 1
    LTEXT           "How applications see it", IDC_SEC_BASE+4, 12, 206, 300, 12
    LTEXT           "", IDC_BR_HOWTO, 12, 220, 424, 70, SS_LEFT | SS_NOPREFIX
END

IDD_PAGE_SETTINGS DIALOGEX 0, 0, 448, 340
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Audio device", IDC_SEC_BASE+5, 12, 10, 200, 12
    LTEXT           "Network interface:", -1, 12, 28, 70, 10
    COMBOBOX        IDC_IFACE, 84, 26, 130, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sample rate:", -1, 12, 48, 70, 10
    COMBOBOX        IDC_RATE, 84, 46, 70, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Channels:", -1, 12, 68, 70, 10
    COMBOBOX        IDC_CHANNELS, 84, 66, 110, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Buffer (frames):", -1, 12, 88, 70, 10
    COMBOBOX        IDC_BUFFER, 84, 86, 60, 120, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Playout delay (ms):", -1, 12, 108, 70, 10
    EDITTEXT        IDC_LINKOFF, 84, 106, 40, 12
    LTEXT           "4 default; 1-2 on a quiet LAN", -1, 130, 108, 100, 10

    LTEXT           "Clock", IDC_SEC_BASE+6, 240, 10, 200, 12
    LTEXT           "PTP mode:", -1, 240, 28, 50, 10
    COMBOBOX        IDC_PTPMODE, 292, 26, 100, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Domain:", -1, 240, 48, 50, 10
    EDITTEXT        IDC_PTPDOMAIN, 292, 46, 30, 12, ES_NUMBER
    LTEXT           "Automatic follows any grandmaster on the network and only becomes master when none exists.", -1, 240, 62, 196, 20

    LTEXT           "Appearance", IDC_SEC_BASE+7, 240, 90, 200, 12
    LTEXT           "Theme:", -1, 240, 108, 50, 10
    COMBOBOX        IDC_THEME, 292, 106, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP

    CONTROL         "", IDC_LINE_BASE+5, "Static", SS_OWNERDRAW, 12, 130, 424, 1
    LTEXT           "Startup", IDC_SEC_BASE+8, 12, 140, 200, 12
    CONTROL         "Start this app with Windows (hidden in the tray)", IDC_AUTORUN, "Button", BS_OWNERDRAW | WS_TABSTOP, 12, 156, 240, 10
    LTEXT           "Combine with the bridge autostart option to run unattended.", -1, 12, 170, 300, 10

    CONTROL         "", IDC_LINE_BASE+6, "Static", SS_OWNERDRAW, 12, 188, 424, 1
    LTEXT           "Maintenance", IDC_SEC_BASE+9, 12, 198, 200, 12
    CONTROL         "Check driver installation", IDC_CHECKDRV, "Button", BS_OWNERDRAW | WS_TABSTOP, 12, 214, 120, 18
    CONTROL         "Open config && log folder", IDC_OPENCFG, "Button", BS_OWNERDRAW | WS_TABSTOP, 138, 214, 120, 18
    CONTROL         "About / help", IDC_ABOUT, "Button", BS_OWNERDRAW | WS_TABSTOP, 264, 214, 90, 18

    LTEXT           "Changes take effect when you press Apply. Stream, clock and bridge changes are picked up live; interface, sample rate, channel or buffer changes restart the audio engine (an open ASIO host is asked to reset).", -1, 12, 246, 424, 30, SS_LEFT | SS_NOPREFIX
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,2,0
 PRODUCTVERSION 0,6,2,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "AES67 Virtual Sound Card"
            VALUE "FileVersion", AES67VSC_VERSION
            VALUE "InternalName", "aes67vsc-panel"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "aes67vsc-panel.exe"
            VALUE "ProductName", "AES67 Virtual Sound Card"
            VALUE "ProductVersion", AES67VSC_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
